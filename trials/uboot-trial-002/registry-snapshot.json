{
  "rules": [
    {
      "path": "**/*.{c,h}",
      "scenarios": [
        "cwe-125-out-of-bounds-read",
        "cwe-190-integer-overflow",
        "cwe-362-race-condition",
        "cwe-401-memory-leak",
        "cwe-416-use-after-free",
        "cwe-476-null-pointer-dereference",
        "cwe-78-os-command-injection",
        "cwe-787-out-of-bounds-write"
      ]
    },
    {
      "path": "**/*.{cc,cpp,hpp}",
      "scenarios": [
        "cwe-125-out-of-bounds-read",
        "cwe-190-integer-overflow",
        "cwe-22-path-traversal",
        "cwe-362-race-condition",
        "cwe-401-memory-leak",
        "cwe-416-use-after-free",
        "cwe-476-null-pointer-dereference",
        "cwe-78-os-command-injection",
        "cwe-787-out-of-bounds-write"
      ]
    },
    {
      "path": "**/*",
      "scenarios": [
        "cwe-20-input-validation",
        "cwe-798-hardcoded-credentials",
        "default"
      ]
    },
    {
      "path": "**/*.java",
      "scenarios": [
        "cwe-22-path-traversal",
        "cwe-362-race-condition",
        "cwe-476-null-pointer-dereference",
        "cwe-78-os-command-injection",
        "cwe-79-xss",
        "cwe-89-sql-injection"
      ]
    },
    {
      "path": "**/*.py",
      "scenarios": [
        "cwe-22-path-traversal",
        "cwe-78-os-command-injection",
        "cwe-89-sql-injection"
      ]
    },
    {
      "path": "**/*.{js,jsx,mjs,cjs}",
      "scenarios": [
        "cwe-22-path-traversal",
        "cwe-78-os-command-injection",
        "cwe-79-xss",
        "cwe-89-sql-injection"
      ]
    },
    {
      "path": "**/*.{ts,tsx}",
      "scenarios": [
        "cwe-22-path-traversal",
        "cwe-78-os-command-injection",
        "cwe-79-xss",
        "cwe-89-sql-injection"
      ]
    },
    {
      "path": "**/*.go",
      "scenarios": [
        "cwe-22-path-traversal",
        "cwe-362-race-condition",
        "cwe-78-os-command-injection",
        "cwe-89-sql-injection"
      ]
    },
    {
      "path": "**/*.php",
      "scenarios": [
        "cwe-22-path-traversal",
        "cwe-78-os-command-injection",
        "cwe-79-xss",
        "cwe-89-sql-injection"
      ]
    },
    {
      "path": "**/*.rs",
      "scenarios": [
        "cwe-22-path-traversal",
        "cwe-89-sql-injection"
      ]
    }
  ]
}
