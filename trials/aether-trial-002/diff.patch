+std::array<uint8_t, nas::aka::kRandLen> amf_rand() {
+    static std::mt19937_64 rng{std::random_device{}()};
+    std::array<uint8_t, nas::aka::kRandLen> r;
+    for (auto& b : r) b = static_cast<uint8_t>(rng() & 0xFF);
