{
  "rules": [
    {
      "path": "**/*.{c,cc,cpp,h,hpp}",
      "scenarios": [
        "cwe-190-integer-overflow",
        "cwe-401-memory-leak",
        "cwe-416-use-after-free",
        "cwe-476-null-deref",
        "cwe-787-buffer-overflow"
      ]
    },
    {
      "path": "**/*.{c,cc,cpp,h,hpp,java,go}",
      "scenarios": [
        "cwe-362-race-condition"
      ]
    },
    {
      "path": "**/concurrent/**",
      "scenarios": [
        "cwe-362-race-condition"
      ]
    },
    {
      "path": "**/thread*/**",
      "scenarios": [
        "cwe-362-race-condition"
      ]
    },
    {
      "path": "**/async*/**",
      "scenarios": [
        "cwe-362-race-condition"
      ]
    },
    {
      "path": "**/*.java",
      "scenarios": [
        "cwe-476-null-deref"
      ]
    },
    {
      "path": "**/*",
      "scenarios": [
        "default"
      ]
    }
  ]
}
