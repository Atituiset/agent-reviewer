{
  "rules": [
    {
      "path": "**/*.{c,h}",
      "scenarios": [
        "cwe-125",
        "cwe-190",
        "cwe-362",
        "cwe-401",
        "cwe-416",
        "cwe-476",
        "cwe-78",
        "cwe-787"
      ]
    },
    {
      "path": "**/*.{cc,cpp,hpp}",
      "scenarios": [
        "cwe-125",
        "cwe-190",
        "cwe-22",
        "cwe-362",
        "cwe-401",
        "cwe-416",
        "cwe-476",
        "cwe-78",
        "cwe-787"
      ]
    },
    {
      "path": "**/*",
      "scenarios": [
        "cwe-20",
        "cwe-798",
        "default"
      ]
    },
    {
      "path": "**/*.java",
      "scenarios": [
        "cwe-22",
        "cwe-362",
        "cwe-476",
        "cwe-78",
        "cwe-79",
        "cwe-89"
      ]
    },
    {
      "path": "**/*.py",
      "scenarios": [
        "cwe-22",
        "cwe-78",
        "cwe-89"
      ]
    },
    {
      "path": "**/*.{js,jsx,mjs,cjs}",
      "scenarios": [
        "cwe-22",
        "cwe-78",
        "cwe-79",
        "cwe-89"
      ]
    },
    {
      "path": "**/*.{ts,tsx}",
      "scenarios": [
        "cwe-22",
        "cwe-78",
        "cwe-79",
        "cwe-89"
      ]
    },
    {
      "path": "**/*.go",
      "scenarios": [
        "cwe-22",
        "cwe-362",
        "cwe-78",
        "cwe-89"
      ]
    },
    {
      "path": "**/*.php",
      "scenarios": [
        "cwe-22",
        "cwe-78",
        "cwe-79",
        "cwe-89"
      ]
    },
    {
      "path": "**/*.rs",
      "scenarios": [
        "cwe-22",
        "cwe-89"
      ]
    }
  ]
}
